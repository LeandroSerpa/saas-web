# URLs publicas usadas pelo frontend.
# Em homologacao, defina a API HML aqui e o frontend nao fara fallback para producao.
VITE_API_URL=https://api-hml.nuvemmais.com.br
VITE_PUBLIC_APP_URL=https://gestao-hml.nuvemmais.com.br
VITE_APP_NAME=NuvemMais Gestão
VITE_APP_VERSION=0.0.0
VITE_APP_ENVIRONMENT=homologacao

# Servidor de producao com SEO dinamico. O EasyPanel deve disponibilizar
# VITE_API_URL tambem em runtime, nao apenas durante o build.
PORT=4173
SEO_CACHE_TTL_MS=60000
SEO_API_TIMEOUT_MS=3000
